# Fonctionne immédiatement sans clé. Passez à false pour les appels OpenAI réels.
DEMO_MODE=true
OPENAI_API_KEY=
PORT=3000
# Modèles configurables sans modifier le code :
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o
# En production, domaine exact de l'app web éventuelle. Une app native n'envoie pas toujours Origin.
ALLOWED_ORIGIN=*
